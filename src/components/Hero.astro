---
import { Image } from 'astro:assets';
import logo from '../assets/brand/avx-logo.png';
import malla from '../assets/brand/malla.png';
import { hero } from '../data/site';
---
<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="malla" aria-hidden="true" style={`background-image: url(${malla.src})`}></div>
  <div class="shell hero-inner">
    <Image src={logo} alt="AVX Informática" width={200} densities={[1, 1.95]} class="logo" loading="eager" fetchpriority="high" />
    <p class="eyebrow eyebrow--center"><span aria-hidden="true">AVX //</span> {hero.eyebrow}</p>
    <h1 class="h1" id="hero-titulo">
      {hero.title[0]}<br /><span class="accent-line">{hero.title[1]}</span>
    </h1>
    <p class="hero-lead thin">{hero.lead}</p>
    <div class="actions">
      <a class="btn btn--primary" href="#contacto">Conversemos <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#trabajos">Ver trabajos</a>
    </div>
    <ul class="chips" aria-label="Condiciones del servicio">
      {hero.chips.map((c) => <li><span class="dot" aria-hidden="true"></span>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: min(100svh, 1000px); display: grid; align-items: center;
    padding-block: 7rem 6rem; overflow: hidden; isolation: isolate;
    background: radial-gradient(ellipse 60% 45% at 50% 32%, rgba(125, 233, 255, 0.07), transparent 70%), var(--bg);
  }
  .malla {
    position: absolute; inset: auto 0 0 0; height: 62%; z-index: -1;
    background-repeat: no-repeat; background-position: center bottom; background-size: cover;
    opacity: 0.32;
    -webkit-mask-image: linear-gradient(to top, #000 35%, transparent);
    mask-image: linear-gradient(to top, #000 35%, transparent);
  }
  .hero-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.6rem; }

  .logo { width: clamp(120px, 14vw, 170px); height: auto; animation: logo-in 0.9s var(--ease) both; }
  @keyframes logo-in { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: none; } }

  .eyebrow--center::after { display: none; }
  .eyebrow--center::before { content: ""; width: 3rem; height: 1px; background: currentColor; opacity: 0.5; }
  .eyebrow--center { gap: 0.75rem; }

  .h1 { font-size: clamp(2.8rem, 7vw, 5.75rem); max-width: 22ch; animation: rise 0.7s 0.15s var(--ease) both; }
  .accent-line { color: var(--accent); }
  .hero-lead {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem); color: var(--text); line-height: 1.35; max-width: 36ch; text-wrap: balance;
    animation: rise 0.7s 0.25s var(--ease) both;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; margin-top: 0.4rem; animation: rise 0.7s 0.35s var(--ease) both; }

  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.75rem; margin-top: 1.2rem; animation: rise 0.7s 0.45s var(--ease) both; }
  .chips li {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2);
  }
  .dot { width: 6px; height: 6px; background: var(--accent); box-shadow: 0 0 10px var(--accent); transform: rotate(45deg); }

  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  @media (max-width: 600px) {
    .hero { padding-block: 6rem 4rem; }
    .eyebrow--center { white-space: nowrap; letter-spacing: 0.14em; }
    .eyebrow--center::before { display: none; }
    .actions { flex-direction: column; width: 100%; }
    .actions .btn { width: 100%; }
    .chips { flex-direction: column; align-items: center; gap: 0.6rem; }
  }
</style>
